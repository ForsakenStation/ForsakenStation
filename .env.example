# Emulator Frontend Configuration

# Path to ROMs directory (legacy file-based ROMs)
# Structure: ROMS_PATH/platform/rom.txt
# Leave empty if using JSONL-based ROMs
ROMS_PATH=/path/to/roms

# Path to JSONL ROMs directory (AndroidRoms format)
# Structure: JSONL_ROMS_PATH/platform.jsonl
# Each JSONL file contains ROM entries with download URLs
# Set this to use JSONL-based ROMs instead of file-based ROMs
JSONL_ROMS_PATH=tmp_scripts/AndroidRoms-main

# Path to media directory
# Structure: MEDIA_PATH/platform/boxart|screenshots|videos|logos/rom.png
MEDIA_PATH=/path/to/media

# Path to emulators directory (contains emulator binaries)
EMULATORS_PATH=/path/to/emulators

# Note: Gamelist path is now managed automatically by the app
# Gamelists are stored in: ~/.local/share/com.example.emulator/gamelists/{platform}/gamelist.xml
# This makes the app independent and prepares for future GitHub-based distribution

# Note: config.json is now bundled with the app in assets/config.json
# User modifications are saved to shared_preferences automatically

# Debug/Logging Configuration
# Enable debug logging (true/false). Default: true in debug mode, false in release mode
DEBUG_ENABLED=true

# Minimum log level to display: debug, info, warning, error, none
# Default: debug
DEBUG_MIN_LEVEL=debug
