# ScreenScraper.fr credentials
# Create account at: https://www.screenscraper.fr/

# Your ScreenScraper account credentials
SCREENSCRAPER_USER=your_username
SCREENSCRAPER_PASSWORD=your_password

# Optional: ScreenScraper developer credentials
# If you have developer access, add your dev ID and password here
# Otherwise, the script will use generic credentials (may have rate limits)
# SCREENSCRAPER_DEV_ID=your_dev_id
# SCREENSCRAPER_DEV_PASSWORD=your_dev_password
